#!/bin/bash
# Input settings
# This file is read by the "readline" library when a new shell is started

# Keep the system defaults (e.g. Git for Windows ships useful ones), then override
$include /etc/inputrc

set editing-mode vi

# How long (ms) to wait after Esc for a longer key sequence; the 500 default makes Esc feel laggy
set keyseq-timeout 25
